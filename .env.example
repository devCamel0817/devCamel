# Firebase Realtime Database (실시간 접속자 카운터용)
# Firebase Console → 프로젝트 설정 → 일반 → 내 앱 → SDK 설정 및 구성에서 복사
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend API Base URL
# - 로컬 개발:  http://localhost:8080
# - 운영:       https://<백엔드도메인>
# - 임시 IP:    http://<ORACLE_VM_PUBLIC_IP>   (Vercel(HTTPS)에서는 Mixed Content 차단됨)
# trailing slash 없이 저장 (예: https://api.example.com)
VITE_API_BASE_URL=http://localhost:8080
